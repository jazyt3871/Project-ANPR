# ---------------------------------------------------------------------------
# Database
#
# Postgres with PostGIS on the same machine as the app. scripts/install-linux.sh
# writes this whole file for you, with a generated password and salt. By hand:
#
#   sudo -u postgres createuser --pwprompt anpr
#   sudo -u postgres createdb --owner anpr anpr
#   sudo -u postgres psql -d anpr -c 'create extension postgis'
#   psql "$DATABASE_URL" -f db/schema.sql
#
# 127.0.0.1, not a hostname: Postgres keeps its default listen_addresses of
# localhost, so the database is never on the network and 5432 stays closed.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://anpr:password@127.0.0.1:5432/anpr?schema=public&connection_limit=10"

# ---------------------------------------------------------------------------
# Photo storage
#
# Photos are files on this server's disk, served through /api/photos. Keep
# UPLOAD_DIR on persistent storage and back it up alongside the database:
# losing one without the other leaves rows pointing at missing photos, or
# photos with no rows.
# ---------------------------------------------------------------------------
UPLOAD_DIR="./storage/uploads"

# ---------------------------------------------------------------------------
# Submission limits
# ---------------------------------------------------------------------------
MAX_UPLOAD_BYTES="8388608"
RATE_LIMIT_PER_HOUR="20"

# Salts the coarse submitter tag stored with each row. Change this in
# production: `openssl rand -hex 32`
SUBMITTER_SALT="change-me"

# ---------------------------------------------------------------------------
# Accounts
#
# Session cookies are marked Secure in production, which means the browser will
# not send them over plain HTTP -- so signing in appears to silently fail when
# the site is served on a bare IP with no certificate. Set this to "true" only
# in that case. Once a domain and HTTPS are in place, remove it.
# ---------------------------------------------------------------------------
# INSECURE_COOKIES="true"
