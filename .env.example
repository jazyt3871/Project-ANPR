# ---------------------------------------------------------------------------
# Supabase — Database
#
# Both come from Supabase: Project Settings -> Database -> Connection string.
# Replace [PROJECT-REF], [YOUR-PASSWORD] and [REGION] with your own values.
# ---------------------------------------------------------------------------

# Transaction pooler, port 6543. This is what serverless functions must use:
# one direct connection per lambda exhausts Postgres' connection limit fast.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct connection, port 5432. Used only by `prisma db push` and
# `prisma studio`; the pooler cannot run DDL.
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# Supabase — Photo storage
#
# Project Settings -> API. The service-role key bypasses RLS, so it is
# server-only: never prefix it with NEXT_PUBLIC_, never commit it.
# ---------------------------------------------------------------------------
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_BUCKET="camera-photos"

# supabase/schema.sql creates the bucket public, so photos are served straight
# from the Supabase CDN. Set to "false" if you make the bucket private; reads
# then stream through /api/photos instead.
# SUPABASE_BUCKET_PUBLIC="true"

# With STORAGE_DRIVER unset the driver is inferred from SUPABASE_URL above.
# Force "local" only for offline development (writes to UPLOAD_DIR) — it cannot
# work on Vercel, where the filesystem is read-only.
# STORAGE_DRIVER="local"
# UPLOAD_DIR="./storage/uploads"

# ---------------------------------------------------------------------------
# Submission limits
# ---------------------------------------------------------------------------
MAX_UPLOAD_BYTES="8388608"
RATE_LIMIT_PER_HOUR="20"

# Salts the coarse submitter tag stored with each row. Change this in
# production: `openssl rand -hex 32`
SUBMITTER_SALT="change-me"
