// Project ANPR — data model
//
// The database is Postgres with PostGIS, on the same machine as the app.
// Everything this file declares is also declared in db/schema.sql, which is the
// source of truth for the parts Prisma cannot express: the postgis extension,
// the `location` geometry column with its trigger and GiST index, and the check
// constraints.
//
// Setup:
//   1. psql "$DATABASE_URL" -f db/schema.sql
//   2. npx prisma generate   (`prisma db push` is a no-op if step 1 ran)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // One long-lived server process holds its own pool, so there is no connection
  // pooler in front and no second URL for DDL.
  url = env("DATABASE_URL")
}

model Camera {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // WGS84 position captured by navigator.geolocation
  lat      Float  @map("latitude")
  lng      Float  @map("longitude")
  accuracy Float? // reported horizontal accuracy radius, in metres

  // Where the camera is looking: degrees clockwise from true north
  heading       Float
  headingSource String @default("sensor") @map("heading_source") // "sensor" | "manual"

  // Photo object key (YYYY/MM/<uuid>.<ext>) under UPLOAD_DIR, resolved to a URL
  // at read time by photoUrl() in src/lib/storage.ts
  photoKey    String @map("photo_key")
  photoWidth  Int?   @map("photo_width")
  photoHeight Int?   @map("photo_height")

  note       String?
  capturedAt DateTime @map("captured_at") // when the submitter stood at the spot
  createdAt  DateTime @default(now()) @map("created_at")

  // Coarse, non-identifying submitter tag so abusive sources can be rate-limited
  submitterHash String? @map("submitter_hash")

  // Who submitted it. Null for rows predating accounts, and for submissions
  // whose account has since been deleted — the camera outlives the account.
  userId String? @map("user_id") @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // NOTE: the `location` geometry(Point, 4326) column is deliberately absent
  // here. Prisma has no geometry type, and the trigger in db/schema.sql keeps
  // it in sync from latitude/longitude. Spatial reads go via $queryRaw.

  @@index([lat, lng])
  @@index([createdAt])
  @@index([userId])
  @@map("cameras")
}

/// An account. Reading the map needs none of this; submitting and deleting do.
model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username     String
  /// scrypt, written and verified only by src/lib/auth.ts. Never leaves the server.
  passwordHash String   @map("password_hash")
  /// "user" | "admin". Admins can delete any camera, not only their own.
  role         String   @default("user")
  createdAt    DateTime @default(now()) @map("created_at")

  sessions Session[]
  cameras  Camera[]

  // The case-insensitive unique index on lower(username) lives in db/schema.sql;
  // Prisma cannot express a functional index, so it is absent here.
  @@map("users")
}

/// A logged-in session. Rows rather than signed tokens, so logout revokes
/// immediately. Only the hash of the token is stored.
model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Shared state for the submission limiter. In the database rather than in
/// process memory so a restart does not hand everyone a fresh quota.
model RateLimitHit {
  id  BigInt   @id @default(autoincrement())
  key String
  at  DateTime @default(now()) @db.Timestamptz(6)

  @@index([key, at(sort: Desc)])
  @@map("rate_limit_hits")
}
